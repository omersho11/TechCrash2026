set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY control_uart_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"

set_global_assignment -name SYSTEMVERILOG_FILE src/control_uart_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/uart_tx.sv
set_global_assignment -name VERILOG_FILE src/adc/altera_up_avalon_adc_mega.v
set_global_assignment -name VERILOG_FILE src/adc/altera_up_avalon_adv_adc.v
set_global_assignment -name VERILOG_FILE src/adc/DE10_Lite_ADC_Core_modular_adc_0.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_control.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_control_avrg_fifo.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_control_fsm.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_sample_store.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_sample_store_ram.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_sequencer.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_sequencer_csr.v
set_global_assignment -name VERILOG_FILE src/adc/altera_modular_adc_sequencer_ctrl.v
set_global_assignment -name VERILOG_FILE src/adc/chsel_code_converter_sw_to_hw.v
set_global_assignment -name VERILOG_FILE src/adc/fiftyfivenm_adcblock_primitive_wrapper.v
set_global_assignment -name VERILOG_FILE src/adc/fiftyfivenm_adcblock_top_wrapper.v

# Clock
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50

# Switches
set_location_assignment PIN_C10 -to SW[0]
set_location_assignment PIN_C11 -to SW[1]
set_location_assignment PIN_D12 -to SW[2]
set_location_assignment PIN_C12 -to SW[3]
set_location_assignment PIN_A12 -to SW[4]
set_location_assignment PIN_B12 -to SW[5]
set_location_assignment PIN_A13 -to SW[6]
set_location_assignment PIN_A14 -to SW[7]
set_location_assignment PIN_B14 -to SW[8]
set_location_assignment PIN_F15 -to SW[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[*]

# Keys are active-low on the DE10-Lite board.
set_location_assignment PIN_B8 -to KEY[0]
set_location_assignment PIN_A7 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[*]

# LEDs mirror the switch state for a quick local sanity check.
set_location_assignment PIN_A8  -to LEDR[0]
set_location_assignment PIN_A9  -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_D13 -to LEDR[4]
set_location_assignment PIN_C13 -to LEDR[5]
set_location_assignment PIN_E14 -to LEDR[6]
set_location_assignment PIN_D14 -to LEDR[7]
set_location_assignment PIN_A11 -to LEDR[8]
set_location_assignment PIN_B11 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]

# One-way UART link to ESP32.
# FPGA ARDUINO_IO[1] -> ESP32 GPIO17 / UART2 RX.
set_location_assignment PIN_AB6 -to FPGA_UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_UART_TX
